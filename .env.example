# =============================================================================
# Ember 环境变量（复制为 .env 后填写；不要提交 .env 到 Git）
# =============================================================================
#
# 【要不要这个文件？】
#   - 本地开发 / 本地构建：建议复制本文件为 .env 再填
#   - Cloudflare Pages / GitHub 部署：不要依赖仓库里的 .env
#     → 在对应平台的「环境变量 / Secrets」里填同名变量即可
#
# 【Cloudflare Pages】项目 → Settings → Environment variables
# 【GitHub Actions】仓库 → Settings → Secrets and variables → Actions
#   （仅当构建跑在 GitHub 上时需要；纯 CF 构建可不管 GitHub）
#
# 带 PUBLIC_ 的会进前端页面；密钥类绝不要加 PUBLIC_ 前缀。
# =============================================================================


# ---------- AI 文章总结（构建时自动生成摘要，不用可全留空）----------

# 是否必填：想用 AI 总结就必填，不用可空
# 控制：调用大模型的 API Key（OpenAI / DeepSeek 等兼容接口）
OPENAI_API_KEY=

# 是否必填：否（有默认）
# 控制：API 地址，默认 https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# 是否必填：否（有默认）
# 控制：用哪个模型，默认 gpt-4o-mini
# AI_MODEL=gpt-4o-mini

# 是否必填：否
# 控制：送给 AI 的正文最长多少字，默认 4000
# AI_MAX_CONTENT_LENGTH=4000

# 是否必填：否
# 控制：摘要最多生成多长，默认 300
# AI_SUMMARY_MAX_TOKENS=300

# 是否必填：否
# 控制：同时生成几篇文章，默认 3
# AI_CONCURRENCY=3


# ---------- Algolia 搜索（searchConfig 里 provider 为 algolia 时）----------
# 不用 Algolia：去 src/config/searchConfig.ts 改成 provider: "pagefind"，下面全可空

# 是否必填：用 Algolia 时必填
# 控制：Algolia 应用 ID（前端搜索用）
# 缺了：自动退回 Pagefind
PUBLIC_ALGOLIA_APP_ID=

# 是否必填：用 Algolia 时必填
# 控制：搜索用的只读 Key（Search-Only，可以进前端）
# 缺了：自动退回 Pagefind
# 注意：不要填 Admin Key
PUBLIC_ALGOLIA_SEARCH_KEY=

# 是否必填：否
# 控制：强行指定索引名（一般不用，留空即可）
# PUBLIC_ALGOLIA_INDEX=

# 是否必填：用 Algolia 且要「构建时更新索引」时必填
# 控制：写入/更新搜索索引的管理员 Key（只给构建用，别公开）
# 本地、CF、GitHub 都可配；CF 请勾选加密
ALGOLIA_ADMIN_API_KEY=

# 是否必填：否（有默认）
# 控制：推到开发库还是生产库。填 dev 或 prod
# 线上 CF 生产构建填 prod；本地日常填 dev 或不填
# ALGOLIA_INDEX_ENV=dev

# 是否必填：写生产索引时必填为 1
# 控制：安全锁。没有它不能覆盖线上索引
# CF 生产构建请设为 1
# ALGOLIA_INDEX_FORCE=1


# ---------- 本地常用命令 ----------
# pnpm algolia:index -- --dev          更新开发索引
# pnpm algolia:index -- --prod --force 更新生产索引（危险，需确认）
# pnpm algolia:index -- --dry-run      只预览，不上传
