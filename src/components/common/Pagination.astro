---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;

const HIDDEN = -1;

const className = Astro.props.class;

const ADJ_DIST = 2;
const VISIBLE = ADJ_DIST * 2 + 1;

// for test
let count = 1;
let l = page.currentPage;
let r = page.currentPage;
while (0 < l - 1 && r + 1 <= page.lastPage && count + 2 <= VISIBLE) {
	count += 2;
	l--;
	r++;
}
while (0 < l - 1 && count < VISIBLE) {
	count++;
	l--;
}
while (r + 1 <= page.lastPage && count < VISIBLE) {
	count++;
	r++;
}

let pages: number[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(HIDDEN);
for (let i = l; i <= r; i++) pages.push(i);
if (r < page.lastPage - 2) pages.push(HIDDEN);
if (r === page.lastPage - 2) pages.push(page.lastPage - 1);
if (r < page.lastPage) pages.push(page.lastPage);

const getPageUrl = (p: number) => {
	if (p === 1) return "/";
	return `/${p}/`;
};
---

<div class:list={[className, "pagination-wrapper flex flex-col gap-4 items-center"]} style={style}>
  <!-- 分页控件 -->
  <div class="pagination-navigation flex flex-row gap-3 justify-center" role="navigation" aria-label={i18n(I18nKey.postList)}>
    <!-- 移动端简化版分页 -->
    <div class="mobile-pagination flex items-center gap-3">
      <a
        href={page.url.prev || "#"}
        aria-label={i18n(I18nKey.paginationPrev)}
        aria-disabled={page.url.prev === undefined ? "true" : "false"}
        tabindex={page.url.prev === undefined ? "-1" : "0"}
        class:list={[
          "pagination-button btn-card overflow-hidden text-(--primary) w-11 h-11",
          { disabled: page.url.prev == undefined },
        ]}
      >
        <Icon is:inline
          name="material-symbols:chevron-left-rounded"
          class="text-[1.75rem]"
          aria-hidden="true"
        />
      </a>

      <div class="pagination-button pagination-button--current btn-card flex items-center px-4 h-11 gap-1.5">
        <span class="text-base font-bold text-(--primary)">{page.currentPage}</span>
        <span class="text-sm text-neutral-500 dark:text-neutral-500">/</span>
        <span class="text-base font-bold text-neutral-700 dark:text-neutral-300">{page.lastPage}</span>
      </div>

      <a
        href={page.url.next || "#"}
        aria-label={i18n(I18nKey.paginationNext)}
        aria-disabled={page.url.next === undefined ? "true" : "false"}
        tabindex={page.url.next === undefined ? "-1" : "0"}
        class:list={[
          "pagination-button btn-card overflow-hidden text-(--primary) w-11 h-11",
          { disabled: page.url.next == undefined },
        ]}
      >
        <Icon is:inline
          name="material-symbols:chevron-right-rounded"
          class="text-[1.75rem]"
          aria-hidden="true"
        />
      </a>
    </div>

    <!-- 桌面端完整版分页 -->
    <div class="desktop-pagination">
      {
        page.url.prev && (
          <a
            href={page.url.prev}
            aria-label={i18n(I18nKey.paginationPrev)}
            class="desktop-pagination__previous pagination-button btn-card overflow-hidden text-(--primary) w-11 h-11"
          >
            <Icon is:inline
              name="material-symbols:chevron-left-rounded"
              class="text-[1.75rem]"
              aria-hidden="true"
            />
          </a>
        )
      }
      <div class="desktop-pagination__pages flex items-center gap-3">
        {
          pages.map((p) => {
            if (p == HIDDEN)
              return <Icon is:inline name="material-symbols:more-horiz" class="w-11 h-11 flex items-center justify-center text-neutral-700 dark:text-neutral-300" aria-hidden="true" />;
            if (p == page.currentPage)
              return (
                <div
                  class="pagination-button pagination-button--current h-11 w-11 flex items-center justify-center font-bold"
                  aria-current="page"
                >
                  {p}
                </div>
              );
            return (
              <a
                href={url(getPageUrl(p))}
                aria-label={`${i18n(I18nKey.paginationPage)} ${p}`}
                class="pagination-button btn-card w-11 h-11 overflow-hidden active:scale-[0.85] text-neutral-700 dark:text-neutral-300"
              >
                {p}
              </a>
            );
          })
        }
        <div
          class="page-jump-control"
          data-first-page-url={url(getPageUrl(1))}
        data-page-url-template={url("/__PAGE__/")}
        data-last-page={page.lastPage}
      >
        <div class="page-jump-control__input-wrapper">
          <input
            class="page-jump-control__input"
            type="text"
            inputmode="numeric"
            pattern="[0-9]*"
            aria-label="跳转页码"
          />
        </div>
        <span class="page-jump-control__label" aria-hidden="true">
          <Icon is:inline name="material-symbols:double-arrow-rounded" class="text-[1.5rem]" />
        </span>
      </div>
      </div>
      {
        page.url.next && (
          <a
            href={page.url.next}
            aria-label={i18n(I18nKey.paginationNext)}
            class="desktop-pagination__next pagination-button btn-card overflow-hidden text-(--primary) w-11 h-11"
          >
            <Icon is:inline
              name="material-symbols:chevron-right-rounded"
              class="text-[1.75rem]"
              aria-hidden="true"
            />
          </a>
        )
      }
    </div>
  </div>
</div>

<script>
  import { normalizePageInput } from "@/utils/pagination-utils";

  function initializePageJumpControls() {
    document.querySelectorAll<HTMLElement>(".page-jump-control").forEach((control) => {
      const input = control.querySelector<HTMLInputElement>(".page-jump-control__input");
      if (!input || input.dataset.initialized === "true") return;

      input.dataset.initialized = "true";
      const lastPage = Number.parseInt(control.dataset.lastPage || "", 10);
      const firstPageUrl = control.dataset.firstPageUrl;
      const pageUrlTemplate = control.dataset.pageUrlTemplate;

      if (!Number.isInteger(lastPage) || !firstPageUrl || !pageUrlTemplate) return;

      input.addEventListener("input", () => {
        input.value = normalizePageInput(input.value, lastPage).value;
      });

      const resetInput = () => {
        input.value = "";
      };

      input.addEventListener("blur", resetInput);
      control.addEventListener("mouseleave", () => {
        resetInput();
        input.blur();
      });

      input.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") return;

        const { value, page } = normalizePageInput(input.value, lastPage);
        input.value = value;
        if (page === null) return;

        window.location.href =
          page === 1 ? firstPageUrl : pageUrlTemplate.replace("__PAGE__", String(page));
      });
    });
  }

  initializePageJumpControls();
  document.addEventListener("astro:page-load", initializePageJumpControls);
</script>

<style>
  .pagination-wrapper {
    width: 100%;
    max-width: 100%;
  }

  .pagination-navigation {
    width: 100%;
  }

  .mobile-pagination {
    display: flex;
    padding: 0 1rem;
  }

  .desktop-pagination {
    display: none;
  }

  .desktop-pagination__previous,
  .desktop-pagination__next {
    position: absolute;
    top: 0;
  }

  .desktop-pagination__previous {
    left: 0;
  }

  .desktop-pagination__next {
    right: 0;
  }

  .pagination-button,
  .page-jump-control {
    border: 1px solid var(--line-divider);
    border-radius: 1.5rem;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--primary) 8%, transparent);
    transition:
      background-color 0.25s ease-out,
      border-color 0.25s ease-out,
      box-shadow 0.25s ease-out,
      color 0.25s ease-out,
      transform 0.25s ease-out,
      width 0.2s ease-out;
  }

  .pagination-button:hover,
  .pagination-button--current,
  .page-jump-control:hover,
  .page-jump-control:focus-within {
    background-color: var(--interactive-accent-bg);
    border-color: var(--primary);
    box-shadow: 0 8px 18px color-mix(in srgb, var(--primary) 22%, transparent);
    color: var(--interactive-hover-fg);
    transform: translateY(-2px);
  }

  .pagination-button--current {
    cursor: default;
  }

  .pagination-button--current :where(*) {
    color: inherit;
  }

  .page-jump-control {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    overflow: hidden;
    background: var(--card-bg);
    color: #000;
  }

  :root.dark .page-jump-control {
    color: #fff;
  }

  .page-jump-control:hover,
  .page-jump-control:focus-within {
    width: 8rem;
  }

  :root.dark .page-jump-control:hover,
  :root.dark .page-jump-control:focus-within {
    color: #000;
  }

  .page-jump-control__label {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    pointer-events: none;
  }

  .page-jump-control__input-wrapper {
    position: absolute;
    top: 0;
    right: 2.75rem;
    bottom: 0;
    left: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease-out;
  }

  .page-jump-control:hover .page-jump-control__label,
  .page-jump-control:focus-within .page-jump-control__label {
    right: 0;
  }

  .page-jump-control:hover .page-jump-control__input-wrapper,
  .page-jump-control:focus-within .page-jump-control__input-wrapper {
    opacity: 1;
    pointer-events: auto;
  }

  .page-jump-control__input {
    width: 100%;
    height: 100%;
    padding: 0 0.75rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: inherit;
    font-weight: 700;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .mobile-pagination {
      display: none;
    }
    .desktop-pagination {
      display: flex;
      position: relative;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 2.75rem;
      gap: 0.75rem;
    }
  }

  @media (max-width: 640px) {
    .mobile-pagination {
      padding: 0 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .mobile-pagination {
      padding: 0 0.25rem;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .mobile-pagination a,
    .mobile-pagination div {
      min-height: 44px;
      min-width: 44px;
    }
  }
</style>
