---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import type { BannerConfig } from "@/types/bannerConfig";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getImageQuality } from "@/utils/image-utils";

interface Props {
	title?: string;
	isBannerMode: boolean;
	isFullscreenMode: boolean;
	isBackgroundEnabled: boolean;
	isHomePage: boolean;
	isPostPage: boolean;
	bannerConfig?: BannerConfig;
	bannerPostMeta?: {
		title: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
	postImage?: string;
	postImageBasePath?: string;
	shouldRenderWaves: boolean;
	wavesEnabledOnDesktop?: boolean;
	wavesEnabledOnMobile?: boolean;
}

const {
	isBackgroundEnabled,
	isHomePage,
	isPostPage,
	bannerConfig,
	bannerPostMeta,
	postImage,
	postImageBasePath = "/",
	shouldRenderWaves,
	wavesEnabledOnDesktop,
	wavesEnabledOnMobile,
} = Astro.props;

const configQuality = getImageQuality();
const mobileQuality = Math.round(configQuality * 0.9);
const effectivePostImage = bannerConfig?.image ?? postImage;
const effectivePostImageBasePath =
	bannerConfig?.imageBasePath ?? postImageBasePath;
const hasPostImage = !!effectivePostImage && effectivePostImage !== "";
const isPostBanner = isBackgroundEnabled && !isHomePage && isPostPage;
const showBannerPostMeta =
	bannerConfig?.showPostMeta !== false && isPostBanner && !!bannerPostMeta;
---

<div
	id="post-banner-image"
	class:list={[
		"absolute inset-0 pointer-events-none overflow-hidden bg-(--page-bg)",
		{ "post-banner-surface": isPostBanner },
	]}
	style="z-index: 6"
>
	{hasPostImage && effectivePostImage && (
		<>
			<div class="absolute inset-0 block lg:hidden">
				<ImageWrapper
					alt="Post banner image"
					class="object-cover h-full w-full post-banner-cover"
					src={effectivePostImage}
					basePath={effectivePostImageBasePath}
					position="center"
					widths={[640, 750, 1080]}
					sizes="100vw"
					loading="eager"
					fetchpriority="high"
					quality={mobileQuality}
				/>
			</div>
			<div class="post-banner-cover-frame absolute hidden lg:block">
				<ImageWrapper
					alt="Post banner image"
					class="object-cover h-full w-full post-banner-cover"
					src={effectivePostImage}
					basePath={effectivePostImageBasePath}
					position="center"
					widths={[1280, 1920, 2560]}
					sizes="100vw"
					loading="eager"
					fetchpriority="high"
					quality={configQuality}
				/>
			</div>
		</>
	)}
</div>

<div id="banner-dim-container" class="absolute inset-0 z-10 pointer-events-none">
	<div
		class:list={[
			"banner-dim-overlay absolute inset-0 bg-black/45",
			{ "post-banner-dim-overlay": isPostBanner },
		]}
	></div>
</div>

<div
	id="banner-overlay-container"
	class="hidden"
>
	{showBannerPostMeta && bannerPostMeta && (
		<div class="banner-post-meta-overlay absolute inset-0 z-20 hidden lg:flex items-center">
			<div class="w-4/5 lg:w-[46%] lg:ml-[10%] text-left mb-0">
				<div class="flex flex-col items-start gap-4">
					<div class="banner-post-title font-bold text-white leading-tight">
						{bannerPostMeta.title}
					</div>
					<div class="banner-post-meta-list mt-4 flex flex-wrap items-center gap-2 text-sm md:text-base">
						<span class="btn-regular banner-post-meta-item inline-flex items-center gap-1.5 rounded-(--radius-large) border border-white/25 bg-white/10! px-2 py-1 font-medium text-white! shadow-sm backdrop-blur-sm">
							<Icon
								is:inline
								name="material-symbols:calendar-month-outline-rounded"
								class="text-[1.05em]"
							/>
							<span>{formatDateToYYYYMMDD(bannerPostMeta.published)}</span>
						</span>
						{bannerPostMeta.updated &&
							bannerPostMeta.updated.getTime() !==
								bannerPostMeta.published.getTime() && (
								<span class="btn-regular banner-post-meta-item inline-flex items-center gap-1.5 rounded-(--radius-large) border border-white/25 bg-white/10! px-2 py-1 font-medium text-white! shadow-sm backdrop-blur-sm">
									<Icon
										is:inline
										name="material-symbols:update-rounded"
										class="text-[1.05em]"
									/>
									<span>{formatDateToYYYYMMDD(bannerPostMeta.updated)}</span>
								</span>
							)}
						{typeof bannerPostMeta.words === "number" && (
							<span class="btn-regular banner-post-meta-item inline-flex items-center gap-1.5 rounded-(--radius-large) border border-white/25 bg-white/10! px-2 py-1 font-medium text-white! shadow-sm backdrop-blur-sm">
								<Icon
									is:inline
									name="material-symbols:ink-pen-outline-rounded"
									class="text-[1.05em]"
								/>
								<span>{bannerPostMeta.words}</span>
							</span>
						)}
						{typeof bannerPostMeta.minutes === "number" && (
							<span class="btn-regular banner-post-meta-item inline-flex items-center gap-1.5 rounded-(--radius-large) border border-white/25 bg-white/10! px-2 py-1 font-medium text-white! shadow-sm backdrop-blur-sm">
								<Icon
									is:inline
									name="material-symbols:schedule-outline-rounded"
									class="text-[1.05em]"
								/>
								<span>{bannerPostMeta.minutes}</span>
							</span>
						)}
					</div>
				</div>
			</div>
		</div>
	)}
</div>

{shouldRenderWaves ? (
	<div
		class={`waves absolute -bottom-px h-[10vh] max-h-37.5 min-h-12.5 w-full md:h-[15vh]
        ${!wavesEnabledOnMobile ? "hidden" : ""} ${!wavesEnabledOnDesktop ? "md:hidden" : ""} ${wavesEnabledOnDesktop ? "md:block" : ""}`}
		id="header-waves"
		style="transform: translateZ(0);"
	>
		<svg
			class="waves"
			xmlns="http://www.w3.org/2000/svg"
			xmlns:xlink="http://www.w3.org/1999/xlink"
			viewBox="0 24 150 28"
			preserveAspectRatio="none"
			shape-rendering="geometricPrecision"
		>
			<defs>
				<path
					id="gentle-wave"
					d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z"
				>
				</path>
			</defs>
			<g class="parallax">
				<use
					xlink:href="#gentle-wave"
					x="48"
					y="0"
					class="opacity-25 fill-(--page-bg)"
				></use>
				<use
					xlink:href="#gentle-wave"
					x="48"
					y="3"
					class="opacity-50 fill-(--page-bg)"
				></use>
				<use
					xlink:href="#gentle-wave"
					x="48"
					y="5"
					class="opacity-75 fill-(--page-bg)"
				></use>
				<use
					xlink:href="#gentle-wave"
					x="48"
					y="7"
					class="fill-(--page-bg)"
				></use>
			</g>
		</svg>
	</div>
) : null}
