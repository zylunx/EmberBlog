---
import type { MarkdownHeading } from "astro";
import Advertisement from "@/components/widget/Advertisement.astro";
import Announcement from "@/components/widget/Announcement.astro";
import Calendar from "@/components/widget/Calendar.astro";
import Categories from "@/components/widget/Categories.astro";
import Profile from "@/components/widget/Profile.astro";
import SidebarTOC from "@/components/widget/SidebarTOC.astro";
import SiteInfo from "@/components/widget/SiteInfo.astro";
import SiteStats from "@/components/widget/SiteStats.astro";
import Tags from "@/components/widget/Tags.astro";
import { sidebarLayoutConfig } from "@/config";
import type { WidgetComponentConfig } from "@/types/config";
import type { ConfiguredSidebarComponentId } from "@/utils/sidebar-utils";

interface Props {
	class?: string;
	componentIds?: ConfiguredSidebarComponentId[];
	headings?: MarkdownHeading[];
	side?: "left" | "right" | "bottom";
}

const componentMap = {
	profile: Profile,
	announcement: Announcement,
	categories: Categories,
	tags: Tags,
	sidebarToc: SidebarTOC,
	advertisement: Advertisement,
	stats: SiteStats,
	calendar: Calendar,
	siteInfo: SiteInfo,
};

const side = Astro.props.side ?? "left";
const className = Astro.props.class;
const componentIds = Astro.props.componentIds ?? [];
const renderableComponents = componentIds
	.filter((id, index) => componentIds.indexOf(id) === index)
	.map((id) => sidebarLayoutConfig.components[id]);

const topComponents =
	side === "bottom"
		? []
		: renderableComponents.filter((config) => config.position === "top");
const stickyComponents =
	side === "bottom"
		? []
		: renderableComponents.filter((config) => config.position === "sticky");
const bottomComponents = side === "bottom" ? renderableComponents : [];
const hasTopComponents = topComponents.length > 0;

const getAnimationDelay = (index: number): string => `${index * 50}ms`;

const getComponentProps = (
	config: WidgetComponentConfig,
	index: number,
): Record<string, unknown> => {
	const baseProps: Record<string, unknown> = {
		class: "onload-animation",
		style: `animation-delay: ${getAnimationDelay(index)}`,
		widgetConfig: config,
	};

	if (config.type === "sidebarToc") {
		return { ...baseProps, headings: Astro.props.headings ?? [] };
	}

	return baseProps;
};
---

{
	renderableComponents.length > 0 && (
		<div
			id={`${side}-sidebar`}
			class:list={[className, "flex flex-col w-full h-full pt-0"]}
		>
			{side === "bottom" ? (
				<div class="flex flex-col w-full gap-4">
					{bottomComponents.map((config, index) => {
						const Component = componentMap[config.type];
						const props = getComponentProps(config, index) as any;
						return <Component {...props} />;
					})}
				</div>
			) : (
				<>
					{topComponents.length > 0 && (
						<div
							class:list={[
								"sidebar-position-group sidebar-position-top flex flex-col w-full gap-4",
								hasTopComponents && "mb-4",
							]}
						>
							{topComponents.map((config, index) => {
								const Component = componentMap[config.type];
								const props = getComponentProps(config, index) as any;
								return <Component {...props} />;
							})}
						</div>
					)}

					{stickyComponents.length > 0 && (
						<div
							id={`${side}-sidebar-sticky`}
							class:list={[
								"sidebar-position-group sidebar-position-sticky flex flex-col w-full mt-auto gap-4 sticky",
								hasTopComponents ? "top-4" : "top-0",
							]}
						>
							{stickyComponents.map((config, index) => {
								const Component = componentMap[config.type];
								const props = getComponentProps(
									config,
									topComponents.length + index,
								) as any;
								return <Component {...props} />;
							})}
						</div>
					)}
				</>
			)}
		</div>
	)
}
