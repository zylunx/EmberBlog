---
import Footer from "@components/layout/Footer.astro";
import Navbar from "@components/layout/Navbar.astro";
import SideBar from "@components/layout/SideBar.astro";
import type { MarkdownHeading } from "astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";
import Banner from "@/components/layout/Banner.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";
import PostBannerMeta from "@/components/layout/PostBannerMeta.astro";
import { backgroundWallpaper, sidebarLayoutConfig, siteConfig } from "@/config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_BANNER_GAP,
} from "@/constants/constants";
import type { BannerConfig } from "@/types/bannerConfig";
import { onAccentFg } from "@/utils/color-utils";
import { isHomePage } from "@/utils/layout-utils";
import {
	generateGridClasses,
	generateMainContentClasses,
	generateRightSidebarClasses,
	generateSidebarClasses,
	getResponsiveSidebarConfig,
} from "@/utils/responsive-utils";
import { resolveSidebarConfig } from "@/utils/sidebar-utils";
import Layout from "./Layout.astro";

import "@/styles/markdown.css";
import "@/styles/expressive-code.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	color?: string;
	postCategory?: string;
	postTags?: string[];
	headings?: MarkdownHeading[];
	bannerPostMeta?: {
		title: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
	// 文章 frontmatter 中的 image 字段（已处理），用于在 banner 显示文章封面
	postImage?: string;
	// 文章图片的基础路径，用于解析本地相对路径图片
	postImageBasePath?: string;
	bannerConfig?: BannerConfig;
	// 文章 frontmatter 的关闭开关；false 关闭当前文章侧栏，不能覆盖全局或页面关闭规则
	sidebar?: boolean;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	color,
	postCategory,
	postTags,
	headings = [],
	bannerPostMeta,
	postImage,
	postImageBasePath = "/",
	bannerConfig,
	sidebar,
} = Astro.props;

const isPostPage = !!postSlug;

// 文章主图取色 HEX 直接作为文章强调色，切页时通过 data 属性同步。
const pageOnAccent = color ? onAccentFg(color) : undefined;

// 仅文章详情页保留顶部视觉区域和水波纹，非文章页固定为 none 模式。
const isBannerMode = isPostPage;
const isFullscreenMode = false;
const effectiveBackgroundEnabled =
	isPostPage && bannerConfig?.enabled !== false;

// 检查文章详情页是否启用水波纹动画效果
const wavesConfig = backgroundWallpaper.articleWaves?.enable;
// 处理分设备控制的水波纹动画
const wavesEnabledOnDesktop =
	typeof wavesConfig === "object" ? wavesConfig.desktop : wavesConfig;
const wavesEnabledOnMobile =
	typeof wavesConfig === "object" ? wavesConfig.mobile : wavesConfig;
const shouldRenderWaves =
	isPostPage && !!(wavesEnabledOnDesktop || wavesEnabledOnMobile);

// 检查是否为首页
const isHomePageCheck = isHomePage(Astro.url.pathname);
const normalizedPathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isArchivePageCheck = normalizedPathname === "/archive";

const shouldRenderCategoryBar =
	!!siteConfig.categoryBar && (isHomePageCheck || isArchivePageCheck);

// 手机端非首页不显示banner的CSS类
const mobileNonHomeBannerClass =
	effectiveBackgroundEnabled && !isHomePageCheck && !isPostPage
		? "mobile-hide-banner"
		: "";

const navbarContentOffset = "var(--navbar-content-offset, 4.5rem)";

// 计算主内容区域位置：文章 banner 下方留固定间距（正文+侧栏一起下移）
const mainPanelTop =
	isBannerMode && effectiveBackgroundEnabled
		? `calc(${BANNER_HEIGHT}vh + ${MAIN_PANEL_BANNER_GAP}rem)`
		: navbarContentOffset;

// 当banner模式被禁用时，主内容区域应该始终从顶栏下面开始
// 非首页在小于1024px时会通过 mobile-main-no-banner CSS类覆盖top值
const finalMainPanelTop =
	isBannerMode && effectiveBackgroundEnabled
		? mainPanelTop
		: navbarContentOffset;

// 文章页使用独立的 post-page-banner 类（由 Layout.astro 添加），不加 no-banner-layout
const isPostPageBannerLayout = isPostPage && effectiveBackgroundEnabled;
const showBannerPostMeta =
	effectiveBackgroundEnabled &&
	isPostPage &&
	bannerConfig?.showPostMeta !== false &&
	!!bannerPostMeta;
const mainContentLayoutClass = isPostPageBannerLayout
	? ""
	: isBannerMode && effectiveBackgroundEnabled
		? ""
		: "no-banner-layout";

const resolvedSidebar = resolveSidebarConfig(Astro.url.pathname, sidebar);
const pageSidebarEnabled = resolvedSidebar.enabled;
const pageSidebarLayout = resolvedSidebar.layout;
const sidebarConfig = getResponsiveSidebarConfig(
	pageSidebarEnabled,
	pageSidebarLayout,
);
const effectiveHasLeftComponents = sidebarConfig.hasLeftComponents;
const effectiveHasRightComponents = sidebarConfig.hasRightComponents;
const effectiveHasMobileBottomComponents =
	pageSidebarEnabled && pageSidebarLayout.mobileBottom.length > 0;
const derivedSidebarPosition = effectiveHasLeftComponents
	? effectiveHasRightComponents
		? "both"
		: "left"
	: effectiveHasRightComponents
		? "right"
		: "none";
const hasSidebarToc = pageSidebarLayout.right.some(
	(id) => sidebarLayoutConfig.components[id].type === "sidebarToc",
);

const { gridCols } = generateGridClasses(sidebarConfig);
const sidebarClass = generateSidebarClasses(sidebarConfig);
const rightSidebarClass = generateRightSidebarClasses(sidebarConfig);
const mainContentClass = generateMainContentClasses(sidebarConfig);
const staticBarClass = mainContentClass.replace("transition-main", "").trim();
const categoryBarClass = ["col-span-1"];

if (
	sidebarConfig.isBothSidebars &&
	sidebarConfig.hasLeftComponents &&
	sidebarConfig.hasRightComponents
) {
	if (sidebarConfig.tabletSidebar === "right") {
		categoryBarClass.push(
			"md:col-start-1",
			"md:col-end-3",
			"xl:col-start-2",
			"xl:col-end-4",
		);
	} else {
		categoryBarClass.push("md:col-start-2", "xl:col-start-2", "xl:col-end-4");
	}
} else if (
	sidebarConfig.hasLeftComponents &&
	!sidebarConfig.hasRightComponents
) {
	categoryBarClass.push("md:col-start-2");
} else if (
	!sidebarConfig.hasLeftComponents &&
	sidebarConfig.hasRightComponents
) {
	categoryBarClass.push("md:col-start-1", "md:col-end-3");
}

const categoryBarClassName = categoryBarClass.join(" ");

const footerClassName = "footer col-span-full onload-animation";

const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const stickyNavbar = siteConfig.navbar.stickyNavbar ?? false;
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug} color={color} bannerEnabled={effectiveBackgroundEnabled}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div
    id="top-row"
    class="z-50 pointer-events-none relative transition-all duration-700 mx-auto"
    class:list={[
        stickyNavbar ? "h-18 fixed top-0 left-0 right-0 z-80" : "",
        navbarWidthFull ? "" : "w-full xl:w-[92vw] max-w-(--page-width) px-0 md:px-4",
    ]}
>
    <div
        id="navbar-wrapper"
        class:list={[
            "pointer-events-auto transition-all",
            stickyNavbar ? "" : "sticky top-0",
        ]}
    >
        <Navbar pageTitle={isPostPage ? title : undefined}></Navbar>
    </div>
</div>

<!-- Article header visual area
     始终渲染 #wallpaper-wrapper 及其内部 Swup 容器，保证从非文章页切到文章页时
     结构一致；非文章页仅隐藏，避免 Swup 替换后缺父层导致布局跳动。 -->
<div
	id="wallpaper-wrapper"
	class:list={[
		`absolute z-10 w-full transition duration-700 overflow-hidden ${mobileNonHomeBannerClass}`,
		!effectiveBackgroundEnabled && "page-banner-disabled",
	]}
	style={`top: -${BANNER_HEIGHT_EXTEND}vh;${effectiveBackgroundEnabled ? "" : "display:none;"}`}
	aria-hidden={effectiveBackgroundEnabled ? "false" : "true"}
>
	<Banner
		title={title}
		isBannerMode={isBannerMode}
		isFullscreenMode={isFullscreenMode}
		isBackgroundEnabled={effectiveBackgroundEnabled}
		isHomePage={isHomePageCheck}
		isPostPage={isPostPage}
		bannerConfig={bannerConfig}
		bannerPostMeta={bannerPostMeta}
		postImage={postImage}
		postImageBasePath={postImageBasePath}
		shouldRenderWaves={shouldRenderWaves}
		wavesEnabledOnDesktop={wavesEnabledOnDesktop}
		wavesEnabledOnMobile={wavesEnabledOnMobile}
	/>
</div>

{showBannerPostMeta && bannerPostMeta ? (
	<div id="post-banner-meta-overlay" class="absolute inset-x-0 top-0 z-40 h-(--banner-height-home) transition-swup-fade">
		<PostBannerMeta category={postCategory} tags={postTags} meta={bannerPostMeta} />
	</div>
) : (
	<div id="post-banner-meta-overlay" class="hidden"></div>
)}

<!-- Main content -->
<div class={`absolute w-full z-30 pointer-events-none ${mobileNonHomeBannerClass ? 'mobile-main-no-banner' : ''} ${mainContentLayoutClass}`} style={isFullscreenMode && effectiveBackgroundEnabled ? 'top: 0;' : `top: ${finalMainPanelTop}`}>
	    {isPostPageBannerLayout && (
	      <div id="post-content-sheet" class="post-content-sheet" aria-hidden="true"></div>
	    )}
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative z-10 w-full xl:w-[92vw] max-w-(--page-width) mx-auto pointer-events-auto">
        <div id="main-grid"
          class={`transition duration-700 w-full left-0 right-0 grid ${gridCols} grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-2 px-1 md:px-2 ${!sidebarConfig.mobileShowSidebar ? 'mobile-no-sidebar' : ''}`}
          data-sidebar-position={derivedSidebarPosition}
          data-tablet-sidebar={sidebarLayoutConfig.tabletSidebar ?? "left"}
        >

            {/* 左右侧栏由 Swup 替换，确保每个页面只渲染其最终布局引用的组件。 */}
            <div
                id="left-sidebar-dynamic"
                class="contents transition-swup-fade"
                data-sidebar-container
                style={pageSidebarEnabled && effectiveHasLeftComponents ? "contain: layout style paint;" : "display: none !important; contain: layout style paint;"}
            >
                <SideBar side="left" componentIds={pageSidebarLayout.left} class={sidebarClass} headings={headings} />
            </div>
                    
            {/* 分类导航栏 - 首页和归档页显示，作为独立 grid item 可跨到右侧栏上方 */}
            {siteConfig.categoryBar && (
                <div
                    id="category-bar-wrapper"
                    class:list={[
                        categoryBarClassName,
                        !shouldRenderCategoryBar && "hidden",
                        isArchivePageCheck && "category-bar-compact",
                    ]}
                >
                    <CategoryBar currentPostCategory={postCategory} />
                </div>
            )}

            {/* 主内容区包装器 - 包含swup容器，作为单个grid item */}
            <div class={staticBarClass}>
                {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
                <main
                    id="swup-container"
                    class="transition-main"
                    data-page-banner-enabled={effectiveBackgroundEnabled ? "true" : "false"}
                    data-is-post-page={isPostPage ? "true" : "false"}
                    data-page-sidebar-enabled={pageSidebarEnabled ? "true" : "false"}
                    data-page-sidebar-has-left={effectiveHasLeftComponents ? "true" : "false"}
                    data-page-sidebar-has-right={effectiveHasRightComponents ? "true" : "false"}
                    data-page-sidebar-has-bottom={effectiveHasMobileBottomComponents ? "true" : "false"}
                    data-page-sidebar-has-toc={hasSidebarToc ? "true" : "false"}
                    data-left-sidebar-class={sidebarClass}
                    data-right-sidebar-class={rightSidebarClass}
                    data-main-content-class={staticBarClass}
                    data-category-bar-class={categoryBarClassName}
                    data-page-title={isPostPage ? title : undefined}
                    data-page-color={color}
                    data-page-on-accent={pageOnAccent}
                    data-current-post-category={postCategory || ""}
                >
                {/* 携带网格布局类名，用于JS更新父容器 */}
                <div id="grid-class-carrier" data-grid-class={gridCols} class="hidden"></div>
                {/* 为每个页面提供一个隐藏的h1标题，用于SEO和可访问性 */}
                <h1 class="sr-only">{title}</h1>
                <div id="content-wrapper" class="onload-animation transition-leaving">
                    <slot></slot>
                </div>
            </main>
            </div>

            <div
                id="right-sidebar-dynamic"
                class="contents transition-swup-fade"
                data-sidebar-container
                style={pageSidebarEnabled && effectiveHasRightComponents ? undefined : "display: none !important;"}
            >
                <SideBar side="right" componentIds={pageSidebarLayout.right} class={rightSidebarClass} headings={headings} />
            </div>

            {/* 移动端底部组件 - 768px及以下显示 */}
            <div id="mobile-bottom-sidebar" class="col-span-1 block md:hidden mt-4" data-sidebar-container style={effectiveHasMobileBottomComponents ? undefined : "display: none !important;"}>
                <SideBar side="bottom" componentIds={pageSidebarLayout.mobileBottom} headings={headings} />
            </div>

            <div class={footerClassName}>
                <Footer></Footer>
            </div>
        </div>

    </div>
</div>

<FloatingControls headings={headings} />


</Layout>

<style is:global>
  /* 右侧栏平滑过渡 */
  #right-sidebar {
    transition: opacity 0.35s ease-in-out,
                transform 0.35s ease-in-out;
  }

  #wallpaper-wrapper.page-banner-disabled {
    display: none !important;
  }

  #main-grid:has(#category-bar-wrapper:not(.hidden)) #right-sidebar {
    grid-row-start: 2 !important;
    grid-row-end: 3 !important;
  }

  /* 有评论区时，侧栏仅与正文行对齐，不跨入页脚行。 */
  @media (min-width: 768px) {
    #main-grid:has(#post-comments) :is(#left-sidebar, #right-sidebar) {
      grid-row-end: 2 !important;
    }
  }

  /* ── 无 category bar、无评论区的右侧栏页面（分类/标签/关于/友链等非文章页）──
     右侧栏默认 md:row-end-3 会比内容多占一行（那一行本是留给首页/归档页 category bar 的）；
     没有 category bar 时该行空在内容卡正下方，表现为「侧栏比内容长出一截、卡片下方一大片空白」。
     让内容单元与右侧栏占相同的 grid 行，并把 #content-wrapper 拉伸到同高，
     使 content-wrapper 的高度与右侧栏齐平；卡片本身不放大，其下方为卡片外的页面留白，
     滚动时侧栏 sticky 底组自然停在这条齐平线上。 */
  @media (min-width: 768px) {
    #main-grid[data-sidebar-position="right"]:not(:has(#category-bar-wrapper:not(.hidden))):not(:has(#post-comments))
      > div:has(> #swup-container:not([data-is-post-page="true"])) {
      grid-row: 1 / 3;
    }
    #main-grid[data-sidebar-position="right"]:not(:has(#category-bar-wrapper:not(.hidden))):not(:has(#post-comments))
      > div:has(> #swup-container:not([data-is-post-page="true"])) > #swup-container {
      height: 100%;
    }
    #main-grid[data-sidebar-position="right"]:not(:has(#category-bar-wrapper:not(.hidden))):not(:has(#post-comments))
      #swup-container:not([data-is-post-page="true"]) > #content-wrapper {
      height: 100%;
    }

    /* 文章页关闭评论时，侧栏与正文内容行对齐，不延伸到页脚行。 */
    #main-grid:has(> div > #swup-container[data-is-post-page="true"]):not(:has(#post-comments))
      > div:has(> #swup-container[data-is-post-page="true"]) {
      grid-row: 1 !important;
      align-self: start;
      height: fit-content;
    }
    #main-grid:has(> div > #swup-container[data-is-post-page="true"]):not(:has(#post-comments))
      :is(#left-sidebar, #right-sidebar) {
      grid-row-end: 2 !important;
    }
  }

  #category-bar-wrapper.category-bar-compact #category-bar {
    margin-bottom: 0.75rem;
    padding: 0.65rem 0.85rem;
  }

  #category-bar-wrapper.category-bar-compact #category-bar .category-pill {
    padding-top: 0.3rem;
    padding-bottom: 0.3rem;
  }

  @keyframes swupFadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.95;
    }
  }

</style>
