---
import { Icon } from "astro-icon/components";
import AlbumCard from "@/components/pages/gallery/AlbumCard.astro";
import NetworkAlbum from "@/components/pages/gallery/NetworkAlbum.svelte";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getAlbumCover, scanAlbumPhotos } from "@/utils/gallery-utils";

if (!siteConfig.pages.gallery) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.gallery);
const description = i18n(I18nKey.galleryDescription);
const networkConfig = galleryConfig.networkAlbum || {};

const albums = galleryConfig.albums.map((album) => {
	const photos = scanAlbumPhotos(album.id);
	const cover = getAlbumCover(album, photos);
	return { ...album, cover, photoCount: photos.length };
});

const allTags = [
	...new Set(albums.flatMap((album) => album.tags || [])),
].sort();
const networkLabels = {
	category: i18n(I18nKey.galleryCategory),
	quantity: i18n(I18nKey.galleryQuantity),
	randomFetch: i18n(I18nKey.galleryRandomFetch),
	fetching: i18n(I18nKey.galleryFetching),
	fetchError: i18n(I18nKey.galleryFetchError),
	noImages: i18n(I18nKey.galleryNoImages),
};
---

<MainGridLayout title={title} description={description}>
  <section class="gallery-page card-base">
    <div class="gallery-page-header">
      <div class="gallery-title-icon">
        <Icon is:inline name="material-symbols:photo-library" class="text-[1.5rem]" />
      </div>
      <div>
        <h1>{title}</h1>
        {description && <p>{description}</p>}
      </div>
    </div>

    <div class="gallery-tabs" data-gallery-tabs>
      <span class="gallery-tabs-indicator" data-gallery-indicator></span>
      <button type="button" class="is-active" data-gallery-tab="local">
        <Icon is:inline name="material-symbols:folder-open" class="text-lg" />
        <span>{i18n(I18nKey.galleryLocalAlbum)}</span>
      </button>
      <button type="button" data-gallery-tab="network">
        <Icon is:inline name="material-symbols:cloud" class="text-lg" />
        <span>{i18n(I18nKey.galleryNetworkAlbum)}</span>
      </button>
    </div>

    <div class="gallery-section is-active" data-gallery-section="local">
      {albums.length > 0 && (
        <gallery-filter class="gallery-filter">
          <div class="gallery-search">
            <Icon is:inline
              name="material-symbols:search"
              class="gallery-search-icon"
            />
            <input
              type="text"
              data-search
              placeholder={i18n(I18nKey.searchAlbums)}
            />
          </div>

          {allTags.length > 0 && (
            <div class="gallery-tag-filter" data-gallery-filter>
              <span class="gallery-filter-indicator" data-gallery-filter-indicator></span>
              <button type="button" class="is-active" data-tag="all">
                {i18n(I18nKey.all)}
              </button>
              {allTags.map((tag) => (
                <button type="button" data-tag={tag}>{tag}</button>
              ))}
            </div>
          )}
        </gallery-filter>
      )}

      {albums.length > 0 ? (
        <>
          <div class="gallery-album-grid">
            {albums.map((album) => (
              <AlbumCard
                id={album.id}
                name={album.name}
                cover={album.cover}
                description={album.description}
                date={album.date}
                location={album.location}
                tags={album.tags}
                photoCount={album.photoCount}
                encrypted={!!album.password}
              />
            ))}
          </div>
          <div class="gallery-empty albums-empty hidden">
            <Icon is:inline name="material-symbols:search-off-rounded" class="text-4xl" />
            <p>{i18n(I18nKey.searchNoResults)}</p>
          </div>
        </>
      ) : (
        <div class="gallery-empty">
          <Icon is:inline name="material-symbols:photo-library" class="text-6xl" />
          <p>{i18n(I18nKey.galleryNoAlbums)}</p>
        </div>
      )}
    </div>

    <div class="gallery-section" data-gallery-section="network">
      <NetworkAlbum
        client:visible
        apiUrl={networkConfig.apiUrl}
        categories={networkConfig.categories}
        defaultCategory={networkConfig.defaultCategory}
        maxQuantity={networkConfig.maxQuantity ?? 10}
        defaultQuantity={networkConfig.defaultQuantity ?? 6}
        cooldownSeconds={networkConfig.cooldownSeconds ?? 5}
        labels={networkLabels}
      />
    </div>
  </section>

  <script is:inline>
    (() => {
      function updateIndicator(container, activeButton, selector) {
        const indicator = container?.querySelector(selector);
        if (!indicator || !activeButton) return;
        indicator.style.left = `${activeButton.offsetLeft}px`;
        indicator.style.top = `${activeButton.offsetTop}px`;
        indicator.style.width = `${activeButton.offsetWidth}px`;
        indicator.style.height = `${activeButton.offsetHeight}px`;
      }

      function activateTab(name, updateHash = true) {
        const tabRoot = document.querySelector("[data-gallery-tabs]");
        if (!tabRoot) return;

        const tabs = [...document.querySelectorAll("[data-gallery-tab]")];
        const sections = [...document.querySelectorAll("[data-gallery-section]")];
        const activeTab = tabs.find((tab) => tab.dataset.galleryTab === name) || tabs[0];
        const activeName = activeTab?.dataset.galleryTab;

        tabs.forEach((tab) => tab.classList.toggle("is-active", tab === activeTab));
        sections.forEach((section) => {
          section.classList.toggle("is-active", section.dataset.gallerySection === activeName);
        });
        updateIndicator(tabRoot, activeTab, "[data-gallery-indicator]");

        if (updateHash && activeName) {
          history.replaceState(
            null,
            "",
            activeName === "network"
              ? "#gallery-network"
              : `${location.pathname}${location.search}`,
          );
        }
      }

      function applyFilters(filterRoot) {
        const container = filterRoot.closest(".gallery-page");
        if (!container) return;

        const input = filterRoot.querySelector("[data-search]");
        const activeTag = filterRoot.querySelector("[data-tag].is-active")?.dataset.tag || "all";
        const query = (input?.value || "").toLowerCase().trim();
        const cards = [...container.querySelectorAll(".album-card")];
        let hasVisible = false;

        cards.forEach((card) => {
          const tags = (card.dataset.tags || "").split(",").filter(Boolean);
          const searchableText = [
            card.dataset.name,
            card.dataset.description,
            card.dataset.location,
            card.dataset.tags,
          ].join(" ").toLowerCase();
          const tagMatch = activeTag === "all" || tags.includes(activeTag);
          const searchMatch = !query || searchableText.includes(query);
          const visible = tagMatch && searchMatch;

          card.toggleAttribute("hidden", !visible);
          card.classList.toggle("gallery-card-fade-in", visible);
          hasVisible ||= visible;
        });

        const empty = container.querySelector(".albums-empty");
        if (empty) empty.classList.toggle("hidden", hasVisible);
      }

      function initGallery() {
        const tabRoot = document.querySelector("[data-gallery-tabs]");
        if (tabRoot) {
          activateTab(location.hash === "#gallery-network" ? "network" : "local", false);
        }

        document.querySelectorAll("[data-gallery-filter]").forEach((filter) => {
          const active = filter.querySelector("[data-tag].is-active") || filter.querySelector("[data-tag]");
          updateIndicator(filter, active, "[data-gallery-filter-indicator]");
        });
      }

      if (!window.__emberGalleryReady) {
        window.__emberGalleryReady = true;

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const tab = target.closest("[data-gallery-tab]");
          if (tab) {
            activateTab(tab.dataset.galleryTab);
            return;
          }

          const tag = target.closest("[data-gallery-filter] [data-tag]");
          if (!tag) return;
          const filter = tag.closest("[data-gallery-filter]");
          filter.querySelectorAll("[data-tag]").forEach((item) => {
            item.classList.toggle("is-active", item === tag);
          });
          updateIndicator(filter, tag, "[data-gallery-filter-indicator]");
          applyFilters(filter.closest("gallery-filter"));
        });

        document.addEventListener("input", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const input = target.closest("gallery-filter [data-search]");
          if (input) applyFilters(input.closest("gallery-filter"));
        });

        window.addEventListener("hashchange", () => {
          activateTab(location.hash === "#gallery-network" ? "network" : "local", false);
        });
        window.addEventListener("resize", initGallery);
        document.addEventListener("astro:page-load", initGallery);
      }

      initGallery();
    })();
  </script>
</MainGridLayout>
